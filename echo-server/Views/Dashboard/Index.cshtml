@model DashboardViewModel
@{
    ViewData["Title"] = $"{Model.Options.AppName} · Live requests";
}

<div id="echo-dashboard" class="container mx-auto px-2 pb-8"
     data-base="@Url.Content("~/_echo/")" data-capacity="@Model.Capacity">

    <div class="bg-@(Model.Options.HeaderColor) mt-8 mb-6 px-4 py-4 sm:rounded-lg flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-medium leading-6 text-white">@Model.Options.AppName</h1>
            <p class="text-white">Echo Server · live requests</p>
        </div>
        <div class="flex items-center gap-2 text-sm text-white">
            <span id="status-dot" class="inline-block h-3 w-3 rounded-full bg-yellow-400"></span>
            <span id="status-text">connecting…</span>
        </div>
    </div>

    <div class="mb-4 flex flex-wrap items-center gap-3">
        <input id="filter" type="search" placeholder="Filter by method, path, IP, content-type…"
               class="flex-1 min-w-[16rem] rounded-md border-gray-300 text-sm" />
        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
            <input id="only-problems" type="checkbox" class="rounded border-gray-300" />
            Problems only (<span id="problem-count">0</span>)
        </label>
        <button id="pause" type="button" class="rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow hover:bg-gray-50">Pause</button>
        <button id="clear" type="button" class="rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white shadow hover:bg-red-700">Clear history</button>
        <span class="text-sm text-gray-700">
            <span id="count">0</span> / @Model.Capacity stored · <span id="total">0</span> received
        </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
        <section class="lg:col-span-2 shadow bg-white sm:rounded-lg overflow-hidden">
            <p class="px-4 py-2 border-b border-gray-200 bg-gray-50 text-xs text-gray-500">
                Navigate with <kbd class="font-mono">↑</kbd> <kbd class="font-mono">↓</kbd> <kbd class="font-mono">PgUp</kbd>
                <kbd class="font-mono">PgDn</kbd> <kbd class="font-mono">Home</kbd> <kbd class="font-mono">End</kbd>
            </p>
            <ul id="list" role="listbox" aria-label="Received requests" class="divide-y divide-gray-100 max-h-[75vh] overflow-y-auto"></ul>
            <p id="empty" class="px-6 py-10 text-center text-sm text-gray-500">
                No requests yet. Send something to any path on this server, e.g.:<br />
                <code class="text-gray-700">curl -X POST @Context.Request.Scheme://@Context.Request.Host/test -d '{"hello":"world"}' -H 'Content-Type: application/json'</code>
            </p>
        </section>

        <section id="detail" class="lg:col-span-3 shadow bg-white sm:rounded-lg overflow-hidden">
            <p class="px-6 py-10 text-center text-sm text-gray-500">Select a request to see its details.</p>
        </section>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/_echo/dashboard.js")" asp-append-version="true"></script>
}
