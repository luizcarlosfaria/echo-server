@model EchoViewModel
@{
    var request = Model.Request;
    var body = request.Body;
    ViewData["Title"] = $"{Model.Options.AppName} · Echo Server";

    const string Th = "px-6 py-3 border-b border-gray-200 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider";
    const string TdKey = "px-6 py-3 whitespace-nowrap align-top text-sm font-medium text-gray-900";
    const string TdValue = "px-6 py-3 text-sm text-gray-500 font-medium break-all";
}

@functions {
    static string Join(string?[] values) => string.Join(", ", values);
}

<div class="container mx-auto px-2">
    <main class="flex-1 relative z-0">
        <!--
            Header color set by the HEADER_COLOR environment variable (default gray-900).
            Palette: https://tailwindcss.com/docs/customizing-colors
        -->
        <div class="bg-@(Model.Options.HeaderColor) mt-8 mb-8 px-4 py-4 sm:rounded-lg flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-medium leading-6 text-white">@Model.Options.AppName</h1>
                <p class="text-white">Echo Server · request #@request.Id</p>
                <p class="text-white">@DateTime.Now.ToString("o")</p>
            </div>
            <a href="@Url.Content("~/_echo")" class="rounded-md bg-white/20 hover:bg-white/30 px-4 py-2 text-sm font-medium text-white">
                View live requests →
            </a>
        </div>

        @if (request.Problems.Count > 0)
        {
            <div class="mt-8 shadow overflow-hidden border border-amber-300 bg-amber-50 sm:rounded-lg">
                <h2 class="px-6 py-3 text-lg font-medium leading-6 text-amber-900">
                    Problems detected in this request (@request.Problems.Count)
                </h2>
                <ul class="divide-y divide-amber-200 bg-white">
                    @foreach (var problem in request.Problems)
                    {
                        var badge = problem.Severity switch
                        {
                            ProblemSeverity.Error => "bg-red-100 text-red-800",
                            ProblemSeverity.Warning => "bg-amber-100 text-amber-800",
                            _ => "bg-gray-100 text-gray-700",
                        };
                        <li class="px-6 py-3 text-sm flex flex-wrap items-start gap-3">
                            <span class="rounded px-2 py-0.5 text-xs font-semibold @badge">@problem.Severity</span>
                            <code class="font-semibold text-gray-900">@problem.Code</code>
                            <span class="text-gray-600 flex-1 min-w-[12rem]">@problem.Message</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="mt-8 shadow overflow-hidden border-b border-gray-300 bg-gray-100 sm:rounded-lg">
            <h2 class="px-6 py-3 text-lg font-medium leading-6 text-gray-900">HTTP Request</h2>
            <table class="min-w-full divide-y divide-gray-200">
                <thead><tr><th class="@Th">Key</th><th class="@Th">Value</th></tr></thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    <tr><td class="@TdKey">Method</td><td class="@TdValue">@request.Method</td></tr>
                    <tr><td class="@TdKey">Scheme</td><td class="@TdValue">@request.Scheme</td></tr>
                    <tr><td class="@TdKey">Host</td><td class="@TdValue">@request.Host</td></tr>
                    <tr><td class="@TdKey">Path</td><td class="@TdValue">@request.PathBase@request.Path</td></tr>
                    <tr><td class="@TdKey">Protocol</td><td class="@TdValue">@request.Protocol</td></tr>
                    <tr><td class="@TdKey">RemoteIp</td><td class="@TdValue">@request.RemoteIp</td></tr>
                    <tr><td class="@TdKey">MachineName</td><td class="@TdValue">@Environment.MachineName</td></tr>
                </tbody>
            </table>
        </div>

        <div class="mt-8 shadow overflow-hidden border-b border-gray-300 bg-gray-100 sm:rounded-lg">
            <h2 class="px-6 py-3 text-lg font-medium leading-6 text-gray-900">HTTP Request Headers</h2>
            <table class="min-w-full divide-y divide-gray-200">
                <thead><tr><th class="@Th">Key</th><th class="@Th">Value</th></tr></thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    @foreach (var header in request.Headers.OrderBy(it => it.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <tr><td class="@TdKey">@header.Key</td><td class="@TdValue">@Join(header.Value)</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-8 shadow overflow-hidden border-b border-gray-300 bg-gray-100 sm:rounded-lg">
            <h2 class="px-6 py-3 text-lg font-medium leading-6 text-gray-900">HTTP Request QueryString</h2>
            <table class="min-w-full divide-y divide-gray-200">
                <thead><tr><th class="@Th">Key</th><th class="@Th">Value</th></tr></thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    @foreach (var item in request.Query)
                    {
                        <tr><td class="@TdKey">@item.Key</td><td class="@TdValue">@Join(item.Value)</td></tr>
                    }
                    @if (request.Query.Count == 0)
                    {
                        <tr><td class="px-6 py-3 text-center text-sm font-medium text-gray-900" colspan="2">No data to display</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (body.Kind != BodyKinds.None)
        {
            <div class="mt-8 shadow overflow-hidden border-b border-gray-300 bg-gray-100 sm:rounded-lg">
                <h2 class="px-6 py-3 text-lg font-medium leading-6 text-gray-900">
                    HTTP Request Body
                    <span class="ml-2 text-sm text-gray-500">@body.Kind · @body.Size bytes@(body.Truncated ? " · truncated" : "")</span>
                </h2>
                @if (body.Form is { Count: > 0 })
                {
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead><tr><th class="@Th">Field</th><th class="@Th">Value</th></tr></thead>
                        <tbody class="bg-white divide-y divide-gray-100">
                            @foreach (var field in body.Form)
                            {
                                <tr><td class="@TdKey">@field.Key</td><td class="@TdValue">@Join(field.Value)</td></tr>
                            }
                        </tbody>
                    </table>
                }
                @if (body.Files is { Count: > 0 })
                {
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead><tr><th class="@Th">File</th><th class="@Th">Details</th></tr></thead>
                        <tbody class="bg-white divide-y divide-gray-100">
                            @foreach (var file in body.Files)
                            {
                                <tr><td class="@TdKey">@file.Name</td><td class="@TdValue">@file.FileName · @file.ContentType · @file.Length bytes</td></tr>
                            }
                        </tbody>
                    </table>
                }
                @if (body.Text is not null)
                {
                    <pre class="bg-white px-6 py-4 text-sm text-gray-800 overflow-x-auto whitespace-pre-wrap break-all">@body.Text</pre>
                }
                @if (body.Base64 is not null)
                {
                    <pre class="bg-white px-6 py-4 text-xs text-gray-600 overflow-x-auto whitespace-pre-wrap break-all">base64: @body.Base64</pre>
                }
            </div>
        }

        @if (Model.EnvironmentVariables is { } environmentVariables)
        {
            <div class="mt-8 shadow overflow-hidden border-b border-gray-300 bg-gray-100 sm:rounded-lg">
                <h2 class="px-6 py-3 text-lg font-medium leading-6 text-gray-900">Environment Variables</h2>
                <table class="min-w-full">
                    <thead><tr><th class="@Th">Key</th><th class="@Th">Value</th></tr></thead>
                    <tbody class="bg-white divide-y divide-gray-100">
                        @foreach (var variable in environmentVariables)
                        {
                            <tr><td class="@TdKey">@variable.Key</td><td class="@TdValue">@variable.Value</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="mb-8"></div>
    </main>
</div>
