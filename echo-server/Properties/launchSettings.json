{
  "profiles": {
    "Echo": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "_echo",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "HEADER_COLOR": "gray-900",
        "APP_NAME": "App1",
        "ECHO_MAX_REQUESTS": "1000",
        "ECHO_SHOW_ENVIRONMENT": "true"
      },
      "applicationUrl": "http://localhost:5080"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/_echo",
      "publishAllPorts": true
    }
  }
}
